# Base path for the flight-api service.
# Keep this a RELATIVE path so requests go through the Vite dev proxy
# (see `server.proxy` in vite.config.ts) and stay same-origin — no CORS.
# Setting an absolute URL such as http://localhost:8080/api bypasses the
# proxy and requires the backend to send CORS headers.
VITE_API_BASE_URL=/api
